{
  "name": "jarxis",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "dev:apple": "node scripts/setup-apple.mjs && next dev",
    "setup:apple": "node scripts/setup-apple.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "registry:drift": "tsx scripts/registry-drift.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:users": "tsx scripts/seed-users.ts",
    "owner": "tsx scripts/owner.ts",
    "providers:worker": "NODE_OPTIONS=--conditions=react-server tsx scripts/providers-worker.ts",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "ml:worker": "pnpm providers:worker"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth-ui/core": "^1.7.26",
    "@better-auth-ui/react": "^1.7.26",
    "@better-auth/prisma-adapter": "1.7.7",
    "@getbrevo/brevo": "^6.0.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scalar/nextjs-api-reference": "^0.12.7",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.24.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "1.7.7",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  }
}
