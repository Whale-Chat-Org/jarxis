{
  "version": "0.2.0",
  "configurations": [
    {
      // Apple native containers: the preLaunchTask installs and starts the infrastructure first.
      // Start Next with the debugger attached and open a debug-attached browser.
      "name": "Dev",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "setup: apple containers",
      "command": "pnpm dev:next",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      // Full Docker Compose setup: prepares .env, installs dependencies, starts services,
      // applies migrations and seeds development users before starting Next.
      "name": "Dev (Docker setup)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    }
  ]
}
