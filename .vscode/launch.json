{
  "version": "0.2.0",
  "configurations": [
    {
      // Starts postgres/redis/azurite via docker compose, then runs `pnpm dev`
      // with the Node debugger auto-attached and opens a debug-attached browser.
      "name": "Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "compose: up dev services",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    }
  ]
}
