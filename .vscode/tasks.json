{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check: typecheck",
      "type": "shell",
      "command": "pnpm typecheck",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "check: lint",
      "type": "shell",
      "command": "pnpm lint",
      "problemMatcher": "$eslint-stylish",
      "group": "build"
    },
    {
      "label": "check: unit tests",
      "type": "shell",
      "command": "pnpm test",
      "problemMatcher": [],
      "group": "test"
    },
    {
      // Installs Apple container if needed, starts PostgreSQL, Redis and Azurite, and prepares the
      // database. Idempotent; runs before "Dev".
      "label": "setup: apple containers",
      "type": "shell",
      "command": "pnpm setup:apple",
      "problemMatcher": []
    },
    {
      "label": "db: reset seeded users",
      "type": "shell",
      "command": "pnpm db:seed:users --reset",
      "problemMatcher": []
    }
  ]
}
