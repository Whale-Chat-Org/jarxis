# Database
DATABASE_URL=postgresql://jarxis:replace-with-url-safe-password@localhost:55432/jarxis
POSTGRES_PASSWORD=replace-with-url-safe-password
POSTGRES_DB=jarxis

# Redis
REDIS_URL=redis://localhost:56379

# Authentication
BETTER_AUTH_URL=http://localhost:3000
# Generate BOTH secrets independently: openssl rand -hex 32
BETTER_AUTH_SECRET=
JWT_SECRET=
# Only behind a trusted proxy that REPLACES X-Real-IP and blocks direct access.
TRUST_PROXY=false

# Provider credential encryption
# Independently generate: openssl rand -hex 32. Exactly 64 hex characters.
# Must differ from BETTER_AUTH_SECRET and JWT_SECRET; retain for credential decryption.
PROVIDERS_ENCRYPTION_KEY=
# Legacy fallback; keep an existing value when upgrading.
ML_ENCRYPTION_KEY=

# Email (Brevo transactional API)
# API key from https://app.brevo.com/settings/keys/api (xkeysib-..., not the SMTP key).
# If Brevo's authorised-IP protection is on, allow this machine's IP first.
BREVO_API_KEY=
# Must be a sender or domain verified in Brevo.
MAIL_FROM=Jarxis <noreply@example.com>

# Private profile-photo storage: S3 / MinIO
# Auto-detect configured Azure Blob and S3 backends.
S3_BUCKET=jarxis-storage
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Local MinIO credentials; setup generates the secret. For AWS, use IAM roles or AWS credentials.
AWS_ACCESS_KEY_ID=jarxis-local
AWS_SECRET_ACCESS_KEY=
MINIO_PORT=9000

# Private profile-photo storage: Azure Blob / Azurite
# Azure Blob is also used when its connection string is set. For local Azurite: UseDevelopmentStorage=true.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=jarxis-storage
AZURITE_BLOB_PORT=10000

# Local LangGraph agent and Studio (use a model that supports function tools)
JARXIS_AGENT_GATEWAY_URL=http://localhost:3000/api/llm/v1
JARXIS_AGENT_GATEWAY_KEY=
JARXIS_AGENT_MODEL=
LANGSMITH_TRACING=false
