# Database
DATABASE_URL=postgresql://jarxis:replace-with-url-safe-password@localhost:55432/jarxis
POSTGRES_PASSWORD=replace-with-url-safe-password
POSTGRES_DB=jarxis

# Redis
REDIS_URL=redis://localhost:56379

# Authentication
# Generate BOTH secrets independently: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
JWT_SECRET=
# Only behind a trusted proxy that REPLACES X-Real-IP and blocks direct access.
TRUST_PROXY=false

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Jarxis <noreply@localhost>

# Private profile-photo storage (local Azurite defaults)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=profile-photos
AZURITE_BLOB_PORT=10000
