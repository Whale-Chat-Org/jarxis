generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MlConnection {
  id                  String       @id @default(uuid())
  name                String
  provider            String
  baseUrl             String       @map("base_url")
  enabled             Boolean      @default(true)
  priority            Int          @default(0)
  encryptedCredential String?      @map("encrypted_credential")
  status              String       @default("pending")
  discoveryStatus     String       @default("pending") @map("discovery_status")
  discoveryError      String?      @map("discovery_error")
  lastDiscoveredAt    DateTime?    @map("last_discovered_at") @db.Timestamptz(6)
  nextDiscoveryAt     DateTime     @default(now()) @map("next_discovery_at") @db.Timestamptz(6)
  cooldownUntil       DateTime?    @map("cooldown_until") @db.Timestamptz(6)
  createdBy           String       @map("created_by")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  models              MlModel[]
  loginJobs           MlLoginJob[]

  @@index([nextDiscoveryAt])
  @@map("ml_connections")
}

model MlModel {
  id           String       @id @default(uuid())
  connectionId String       @map("connection_id")
  upstreamId   String       @map("upstream_id")
  displayName  String       @map("display_name")
  enabled      Boolean      @default(true)
  discovered   Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  connection   MlConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, upstreamId])
  @@map("ml_models")
}

model MlGatewayKey {
  id         String    @id @default(uuid())
  name       String
  prefix     String
  hash       String    @unique
  createdBy  String    @map("created_by")
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ml_gateway_keys")
}

model MlLoginJob {
  id             String       @id @default(uuid())
  connectionId   String       @map("connection_id")
  ownerId        String       @map("owner_id")
  status         String       @default("queued")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  encryptedState String?      @map("encrypted_state")
  encryptedInput String?      @map("encrypted_input")
  loginUrl       String?      @map("login_url")
  instructions   String?
  error          String?
  claimedAt      DateTime?    @map("claimed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  connection     MlConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([connectionId, createdAt])
  @@map("ml_login_jobs")
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  // Better Auth admin plugin fields. `role` holds one or more code-declared role names,
  // comma-separated; an unrecognised name grants nothing (fail closed).
  role          String?
  banned        Boolean       @default(false)
  banReason     String?       @map("ban_reason")
  banExpires    DateTime?     @map("ban_expires") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]
  tokenFamilies TokenFamily[]
  ownerSetup    OwnerSetupRequest?

  @@index([createdAt], map: "user_created_idx")
  @@index([name], map: "user_name_idx")
  @@map("app_user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  token          String   @unique
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  impersonatedBy String?  @map("impersonated_by")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "session_user_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "account_user_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

// Families intentionally outlive deleted sessions to preserve replay evidence.
model TokenFamily {
  id            String         @id
  userId        String         @map("user_id")
  sessionId     String         @map("session_id")
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refreshTokens RefreshToken[]

  @@index([userId], map: "family_user_idx")
  @@index([sessionId], map: "family_session_idx")
  @@map("token_families")
}

model RefreshToken {
  hash       String      @id
  familyId   String      @map("family_id")
  consumedAt DateTime?   @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  family     TokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([familyId], map: "refresh_family_idx")
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id
  actorId   String   @map("actor_id")
  action    String
  targetId  String   @map("target_id")
  changes   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "audit_created_idx")
  @@index([targetId], map: "audit_target_idx")
  @@map("audit_logs")
}

/**
 * Permanent, single-row record that first-owner setup has completed.
 *
 * The row is never deleted: it is the evidence that closes the unauthenticated web setup flow
 * for good. The primary key is pinned to `singleton` by a CHECK constraint in the migration, so
 * a second completion row cannot exist. CLI recovery (`pnpm owner`) is deliberately still
 * allowed once this row exists.
 */
model InstallationSetup {
  id          String   @id
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  /** User the setup created or detected, when known. */
  completedBy String?  @map("completed_by")
  /** How setup closed: `web`, `cli`, `existing-owner` or `migration-backfill`. */
  method      String

  @@map("installation_setup")
}

/**
 * Pending email verification for the first-owner setup flow.
 *
 * `POST /api/setup` creates an unverified candidate user plus one of these rows; the emailed
 * six-digit code is only ever stored as an HMAC-SHA256 digest keyed by `BETTER_AUTH_SECRET`, so
 * a database read cannot reveal a usable code. The row is consumed (`consumedAt`) when the code
 * verifies, which is also when the owner role and the permanent setup marker are written.
 */
model OwnerSetupRequest {
  /** Opaque UUID handed to the client; the only handle the browser keeps. */
  id         String    @id
  userId     String    @unique @map("user_id")
  /** HMAC-SHA256 of the code; the raw code is never stored. */
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  /** Wrong-code attempts; committed even when the request itself is rejected. */
  attempts   Int       @default(0)
  lastSentAt DateTime? @map("last_sent_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "owner_setup_expires_idx")
  @@map("owner_setup_requests")
}
